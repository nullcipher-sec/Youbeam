<mxfile host="Electron"><diagram name="Arquitectura" id="arq"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1180" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="arq-1" value="&lt;b&gt;YouBeam — Arquitectura segura (Docker Compose)&lt;/b&gt;" style="text;html=1;fontSize=24;align=left;" vertex="1" parent="1"><mxGeometry x="20" y="0" width="900" height="40" as="geometry"/></mxCell><mxCell id="arq-2" value="&lt;b&gt;Host Docker — red interna &lt;i&gt;youbeam_net&lt;/i&gt;&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;font style='font-size:11px' color='#7a7a7a'&gt;todos los servicios corren en contenedores aislados; solo se exponen 443/tcp y 8443/udp&lt;/font&gt;" style="rounded=1;arcSize=2;dashed=1;dashPattern=8 4;fillColor=none;strokeColor=#2C7BE5;strokeWidth=2;html=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontSize=15;fontColor=#2C7BE5;" vertex="1" parent="1"><mxGeometry x="420" y="80" width="1240" height="1080" as="geometry"/></mxCell><mxCell id="arq-3" value="Usuario" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=13;" vertex="1" parent="1"><mxGeometry x="50" y="475" width="30" height="60" as="geometry"/></mxCell><mxCell id="arq-4" value="&lt;b&gt;Cliente de Streaming&lt;/b&gt;" style="rounded=1;arcSize=6;fillColor=#fff2cc;strokeColor=#d6b656;html=1;verticalAlign=top;fontSize=15;" vertex="1" parent="1"><mxGeometry x="120" y="360" width="270" height="300" as="geometry"/></mxCell><mxCell id="arq-5" value="&lt;b&gt;CLIENTE&lt;/b&gt; (React, navegador)&lt;br&gt;&lt;font style='font-size:11px' color='#7a7a7a'&gt;aplicación web que usa la persona&lt;/font&gt;&lt;br&gt;&lt;br&gt;• Inicio de sesión, CRUD, catálogo&lt;br&gt;• fetch() → HTTPS&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;font style='font-size:11px' color='#7a7a7a'&gt;peticiones normales, cifradas&lt;/font&gt;&lt;br&gt;• RTCPeerConnection&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;(WebRTC: DTLS + SRTP)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;font style='font-size:11px' color='#7a7a7a'&gt;recibe el video por UDP&lt;/font&gt;&lt;br&gt;• &amp;lt;video&amp;gt; reproduce" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;fillColor=#ffffff;strokeColor=#d6b656;" vertex="1" parent="1"><mxGeometry x="135" y="400" width="240" height="240" as="geometry"/></mxCell><mxCell id="arq-6" value="&lt;b&gt;NGINX&lt;/b&gt; · proxy inverso&lt;br&gt;&lt;font style='font-size:11px' color='#7a7a7a'&gt;puerta de entrada única&lt;/font&gt;&lt;br&gt;&lt;br&gt;TLS 1.3 · 443/tcp&lt;br&gt;&lt;font style='font-size:11px' color='#7a7a7a'&gt;cifra la conexión&lt;/font&gt;&lt;br&gt;certificado X.509&lt;br&gt;&lt;font style='font-size:11px' color='#7a7a7a'&gt;acredita la identidad del servidor&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;fillColor=#f5f5f5;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="440" y="430" width="200" height="170" as="geometry"/></mxCell><mxCell id="arq-7" value="&lt;b&gt;Núcleo de Streaming&lt;/b&gt; (Streaming Core) — Java 21 · Spring Boot" style="rounded=1;arcSize=4;fillColor=#dae8fc;strokeColor=#6c8ebf;html=1;verticalAlign=top;fontSize=15;" vertex="1" parent="1"><mxGeometry x="680" y="130" width="460" height="580" as="geometry"/></mxCell><mxCell id="arq-8" value="&lt;b&gt;DESPACHADOR&lt;/b&gt; (Dispatcher · API Gateway)&lt;br&gt;&lt;font style='font-size:11px' color='#7a7a7a'&gt;recibe cada petición y la envía al servicio que corresponde&lt;/font&gt;&lt;br&gt;• REST /api/*&lt;br&gt;• Señalización WebRTC (oferta/respuesta SDP)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;font style='font-size:11px' color='#7a7a7a'&gt;pone en contacto al navegador con el servidor de video&lt;/font&gt;&lt;br&gt;• Reenvía tickets al Servidor de Streaming" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="710" y="175" width="400" height="150" as="geometry"/></mxCell><mxCell id="arq-9" value="&lt;b&gt;BACKEND&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#7a7a7a'&gt;lógica de negocio: usuarios, videos y permisos&lt;/font&gt;&lt;br&gt;• Autenticación (hash Argon2id)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;font style='font-size:11px' color='#7a7a7a'&gt;la contraseña se guarda como huella irreversible&lt;/font&gt;&lt;br&gt;• CRUD de videos&lt;br&gt;• Autorización: público / oculto / privado&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;font style='font-size:11px' color='#7a7a7a'&gt;decide quién puede ver cada video&lt;/font&gt;&lt;br&gt;• Transcodificación (ffmpeg → VP8/Opus)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;font style='font-size:11px' color='#7a7a7a'&gt;convierte el video a un formato que WebRTC reproduce&lt;/font&gt;&lt;br&gt;• &lt;font color='#8E44AD'&gt;&lt;b&gt;Cifrado en reposo:&lt;/b&gt; AES-256-GCM + DEK envuelta con HPKE&lt;/font&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;font style='font-size:11px' color='#7a7a7a'&gt;el video se guarda cifrado y su clave se protege con criptografía asimétrica&lt;/font&gt;&lt;br&gt;• &lt;font color='#8E44AD'&gt;&lt;b&gt;Firma tickets&lt;/b&gt; de reproducción (ES256)&lt;/font&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;font style='font-size:11px' color='#7a7a7a'&gt;permiso temporal de 60 s que no se puede falsificar&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;fillColor=#ffffff;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="710" y="385" width="400" height="305" as="geometry"/></mxCell><mxCell id="arq-10" value="&lt;b&gt;Servicio de Streaming&lt;/b&gt; — Go · Pion WebRTC" style="rounded=1;arcSize=4;fillColor=#d5e8d4;strokeColor=#82b366;html=1;verticalAlign=top;fontSize=15;" vertex="1" parent="1"><mxGeometry x="1180" y="130" width="460" height="330" as="geometry"/></mxCell><mxCell id="arq-11" value="&lt;b&gt;SERVIDOR DE STREAMING&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#7a7a7a'&gt;único servicio capaz de descifrar los videos&lt;/font&gt;&lt;br&gt;• Verifica el ticket con la clave pública del Núcleo&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;font style='font-size:11px' color='#7a7a7a'&gt;comprueba que el permiso es auténtico y vigente&lt;/font&gt;&lt;br&gt;• &lt;font color='#8E44AD'&gt;&lt;b&gt;Abre la DEK con su clave privada HPKE&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;font style='font-size:11px' color='#7a7a7a'&gt;recupera la clave del video; solo este servicio tiene la clave privada&lt;/font&gt;&lt;br&gt;• Descifra video.enc por bloques (en memoria)&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;font style='font-size:11px' color='#7a7a7a'&gt;el video sin cifrar nunca se escribe en disco&lt;/font&gt;&lt;br&gt;• &lt;font color='#C0392B'&gt;&lt;b&gt;DTLS 1.2&lt;/b&gt;: ECDHE P-256 + firma ECDSA&lt;/font&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;font style='font-size:11px' color='#7a7a7a'&gt;acuerda una clave secreta con el navegador y verifica identidades&lt;/font&gt;&lt;br&gt;• &lt;font color='#C0392B'&gt;&lt;b&gt;SRTP&lt;/b&gt; AES-128-GCM (RFC 5764)&lt;/font&gt;&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&lt;font style='font-size:11px' color='#7a7a7a'&gt;cada paquete de video viaja cifrado y con control de integridad&lt;/font&gt;&lt;br&gt;• Puerto único &lt;b&gt;8443/udp&lt;/b&gt; (multiplexado UDP)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;fillColor=#ffffff;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="1200" y="175" width="420" height="265" as="geometry"/></mxCell><mxCell id="arq-12" value="&lt;b&gt;Almacenamiento&lt;/b&gt;" style="rounded=1;arcSize=4;fillColor=#e1d5e7;strokeColor=#9673a6;html=1;verticalAlign=top;fontSize=15;" vertex="1" parent="1"><mxGeometry x="680" y="780" width="960" height="360" as="geometry"/></mxCell><mxCell id="arq-13" value="&lt;b&gt;PostgreSQL 16&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#7a7a7a'&gt;datos de usuarios, sesiones y videos&lt;/font&gt;&lt;br&gt;&lt;br&gt;users, sessions (token_hash)&lt;br&gt;videos (visibility)&lt;br&gt;&lt;font color='#8E44AD'&gt;video_keys (wrapped_dek)&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#7a7a7a'&gt;claves de video, siempre cifradas&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#ffffff;strokeColor=#9673a6;fontSize=13;" vertex="1" parent="1"><mxGeometry x="720" y="840" width="250" height="270" as="geometry"/></mxCell><mxCell id="arq-14" value="&lt;b&gt;MinIO&lt;/b&gt; (S3 self-hosted)&lt;br&gt;&lt;font style='font-size:11px' color='#7a7a7a'&gt;almacén de archivos propio&lt;/font&gt;&lt;br&gt;&lt;br&gt;videos/{id}/video.enc&lt;br&gt;&lt;font color='#8E44AD'&gt;solo bytes cifrados&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#7a7a7a'&gt;si se roba un archivo, es ilegible&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#ffffff;strokeColor=#9673a6;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1030" y="840" width="260" height="270" as="geometry"/></mxCell><mxCell id="arq-15" value="&lt;b&gt;Secretos Docker&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#7a7a7a'&gt;cada servicio recibe solo las claves que necesita&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font color='#8E44AD'&gt;hpke_private → solo Streaming&lt;br&gt;hpke_public → Núcleo&lt;br&gt;&lt;br&gt;jwt_signing → solo Núcleo&lt;br&gt;jwt_verify → Streaming&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#7a7a7a'&gt;el Núcleo puede cifrar videos&lt;br&gt;pero no descifrarlos&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;fillColor=#ffffff;strokeColor=#8E44AD;dashed=1;" vertex="1" parent="1"><mxGeometry x="1340" y="840" width="270" height="270" as="geometry"/></mxCell><mxCell id="arq-16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#333333;" edge="1" parent="1" source="arq-3" target="arq-5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="arq-17" value="HTTPS · TLS 1.3&lt;br&gt;(TCP 443)&lt;br&gt;&lt;font style='font-size:11px' color='#7a7a7a'&gt;canal cifrado&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#333333;startArrow=block;startFill=1;" edge="1" parent="1" source="arq-5" target="arq-6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="408" y="515"/></Array></mxGeometry></mxCell><mxCell id="arq-18" value="HTTP&lt;br&gt;(red interna)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#333333;startArrow=block;startFill=1;" edge="1" parent="1" source="arq-6" target="arq-8"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="660" y="515"/><mxPoint x="660" y="250"/></Array></mxGeometry></mxCell><mxCell id="arq-19" value="gRPC" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#333333;startArrow=block;startFill=1;" edge="1" parent="1" source="arq-8" target="arq-9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="arq-20" value="gRPC interno&lt;br&gt;SDP + ticket" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#333333;startArrow=block;startFill=1;" edge="1" parent="1" source="arq-8" target="arq-11"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1155" y="250"/><mxPoint x="1155" y="260"/></Array></mxGeometry></mxCell><mxCell id="arq-21" value="TCP 5432 (JDBC)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#333333;startArrow=block;startFill=1;exitX=0.25;exitY=1;exitDx=0;exitDy=0;" edge="1" parent="1" source="arq-9" target="arq-13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="arq-22" value="API S3 · PUT&lt;br&gt;video.enc&lt;br&gt;&lt;font style='font-size:11px' color='#7a7a7a'&gt;guarda cifrado&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#333333;exitX=0.75;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="arq-9" target="arq-14"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1010" y="745"/><mxPoint x="1108" y="745"/></Array></mxGeometry></mxCell><mxCell id="arq-23" value="API S3 · GET&lt;br&gt;video.enc" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#333333;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#333333;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.7;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="arq-11" target="arq-14"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1305" y="745"/><mxPoint x="1212" y="745"/></Array></mxGeometry></mxCell><mxCell id="arq-24" value="lee clave&lt;br&gt;privada" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#8E44AD;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#8E44AD;dashed=1;exitX=0.75;exitY=1;exitDx=0;exitDy=0;" edge="1" parent="1" source="arq-11" target="arq-15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="arq-25" value="&lt;b&gt;UDP 8443 — WebRTC&lt;/b&gt;&lt;br&gt;ICE/STUN → negociación DTLS 1.2 (ECDHE + ECDSA) → SRTP AES-GCM (video + audio)&lt;br&gt;&lt;font style='font-size:11px' color='#7a7a7a'&gt;transmisión del video: si alguien intercepta el tráfico, solo obtiene datos cifrados&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#C0392B;strokeWidth=4;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#FFFFFF;fontColor=#C0392B;startArrow=block;startFill=1;exitX=0.95;exitY=0;exitDx=0;exitDy=0;entryX=0.95;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="arq-11" target="arq-5"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1599" y="60"/><mxPoint x="363" y="60"/></Array></mxGeometry></mxCell><mxCell id="arq-26" value="&lt;b&gt;Leyenda&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font color='#333333'&gt;━━ TCP (HTTPS / gRPC / JDBC / S3)&lt;/font&gt;&lt;br&gt;&lt;font color='#C0392B'&gt;&lt;b&gt;━━ UDP cifrado (DTLS-SRTP)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font color='#8E44AD'&gt;- - - acceso a material de claves&lt;/font&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#7a7a7a'&gt;gris = explicación en lenguaje común&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Dónde está el cifrado asimétrico&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#7a7a7a'&gt;usa un par de claves: la pública cifra o verifica; solo la privada descifra o firma&lt;/font&gt;&lt;br&gt;&lt;br&gt;① TLS 1.3 / DTLS 1.2: ECDHE + ECDSA&lt;br&gt;&lt;font style='font-size:11px' color='#7a7a7a'&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;acordar una clave secreta y comprobar identidades&lt;/font&gt;&lt;br&gt;② HPKE (RFC 9180)&lt;br&gt;&lt;font style='font-size:11px' color='#7a7a7a'&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;proteger la clave de cada video almacenado&lt;/font&gt;&lt;br&gt;③ JWT ES256&lt;br&gt;&lt;font style='font-size:11px' color='#7a7a7a'&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;firmar permisos de reproducción infalsificables&lt;/font&gt;&lt;br&gt;&lt;br&gt;&lt;i&gt;El asimétrico protege las claves; el contenido se&lt;br&gt;cifra con AES (simétrico) por rendimiento.&lt;/i&gt;&lt;br&gt;&lt;font style='font-size:11px' color='#7a7a7a'&gt;cifrar video con RSA/ECC sería demasiado lento&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;fillColor=#fafafa;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="20" y="740" width="380" height="420" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Base de datos" id="db"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1920" pageHeight="1180" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="db-1" value="&lt;b&gt;YouBeam — Modelo entidad-relación (PostgreSQL 16)&lt;/b&gt;" style="text;html=1;fontSize=24;align=left;" vertex="1" parent="1"><mxGeometry x="20" y="0" width="1200" height="40" as="geometry"/></mxCell><mxCell id="db-2" value="Cuentas y sesiones &amp;nbsp;&lt;font style='font-size:11px' color='#7a7a7a'&gt;quién es cada usuario y sus sesiones activas&lt;/font&gt;" style="rounded=1;arcSize=2;html=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontSize=14;fontStyle=1;strokeColor=none;fillColor=#fff8e1;fontColor=#9a7b00;" vertex="1" parent="1"><mxGeometry x="20" y="60" width="440" height="640" as="geometry"/></mxCell><mxCell id="db-3" value="Catálogo de videos &amp;nbsp;&lt;font style='font-size:11px' color='#7a7a7a'&gt;los videos, su dueño y su visibilidad&lt;/font&gt;" style="rounded=1;arcSize=2;html=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontSize=14;fontStyle=1;strokeColor=none;fillColor=#eaf2fc;fontColor=#3a6aa8;" vertex="1" parent="1"><mxGeometry x="480" y="60" width="950" height="360" as="geometry"/></mxCell><mxCell id="db-4" value="Interacción &amp;nbsp;&lt;font style='font-size:11px' color='#7a7a7a'&gt;reacciones, comentarios y reproducciones&lt;/font&gt;" style="rounded=1;arcSize=2;html=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontSize=14;fontStyle=1;strokeColor=none;fillColor=#ecf6ea;fontColor=#4f8a43;" vertex="1" parent="1"><mxGeometry x="480" y="440" width="950" height="400" as="geometry"/></mxCell><mxCell id="db-5" value="Almacenamiento cifrado &amp;nbsp;&lt;font style='font-size:11px' color='#7a7a7a'&gt;dónde está cada archivo y cómo se protege su clave&lt;/font&gt;" style="rounded=1;arcSize=2;html=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=4;fontSize=14;fontStyle=1;strokeColor=none;fillColor=#f3e9f7;fontColor=#8E44AD;" vertex="1" parent="1"><mxGeometry x="480" y="860" width="1420" height="300" as="geometry"/></mxCell><mxCell id="db-6" value="&lt;b&gt;users&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;font color='#555555'&gt;(usuarios)&lt;/font&gt;" style="swimlane;html=1;startSize=32;horizontal=1;collapsible=0;rounded=0;fontSize=13;fontStyle=0;fillColor=#fff2cc;strokeColor=#d6b656;swimlaneFillColor=#ffffff;strokeWidth=1.5;" vertex="1" parent="1"><mxGeometry x="30" y="100" width="420" height="200" as="geometry"/></mxCell><mxCell id="db-7" value="&lt;b&gt;PK&lt;/b&gt;&amp;nbsp;&amp;nbsp;id&amp;nbsp;&amp;nbsp;&lt;font color='#8a8a8a'&gt;UUID&lt;/font&gt;&amp;nbsp;&amp;nbsp;&lt;font color='#8a8a8a'&gt;&lt;i&gt;gen_random_uuid()&lt;/i&gt;&lt;/font&gt;" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=8;fontSize=12;fontFamily=Menlo;fontColor=#222222;" vertex="1" parent="db-6"><mxGeometry x="0" y="32" width="420" height="24" as="geometry"/></mxCell><mxCell id="db-8" value="&lt;b&gt;UQ&lt;/b&gt;&amp;nbsp;&amp;nbsp;username&amp;nbsp;&amp;nbsp;