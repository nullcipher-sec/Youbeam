1" parent="1" source="db-23" target="db-58"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="db-85" value="1:1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#555555;strokeWidth=1.5;startArrow=ERmandOne;startFill=0;endArrow=ERmandOne;endFill=0;endSize=12;startSize=12;fontSize=11;fontColor=#555555;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.93;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="db-23" target="db-67"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="945" y="394"/><mxPoint x="945" y="875"/><mxPoint x="1200" y="875"/></Array></mxGeometry></mxCell><mxCell id="db-86" value="&lt;b&gt;Tipos ENUM&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;font face='Menlo'&gt;user_status&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;active | suspended | deleted&lt;br&gt;session_status&amp;nbsp;&amp;nbsp;active | revoked | expired&lt;br&gt;video_visibility public | hidden | private&lt;br&gt;video_status&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;processing | ready | error&lt;br&gt;asset_type&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;original | hls | thumbnail |&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;encrypted_blob&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;fillColor=#fafafa;strokeColor=#999999;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1460" y="60" width="440" height="160" as="geometry"/></mxCell><mxCell id="db-87" value="&lt;b&gt;Control de acceso&lt;/b&gt;&lt;br&gt;&lt;br&gt;Sin RBAC &lt;font color='#7a7a7a'&gt;(no hay roles ni administradores)&lt;/font&gt;:&lt;br&gt;la autorización es por propiedad&lt;br&gt;(&lt;font face='Menlo'&gt;videos.owner_id&lt;/font&gt;) y por &lt;font face='Menlo'&gt;visibility&lt;/font&gt;:&lt;br&gt;&lt;br&gt;&lt;font face='Menlo'&gt;public&lt;/font&gt;&amp;nbsp;&amp;nbsp;listado · reproducible por cualquiera&lt;br&gt;&lt;font face='Menlo'&gt;hidden&lt;/font&gt;&amp;nbsp;&amp;nbsp;no listado · acceso con el enlace&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;(UUID v4, 122 bits aleatorios)&lt;br&gt;&lt;font face='Menlo'&gt;private&lt;/font&gt;&amp;nbsp;no listado · solo el propietario&lt;br&gt;&lt;br&gt;CRUD restringido a &lt;font face='Menlo'&gt;owner_id = sesión&lt;/font&gt;." style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1460" y="240" width="440" height="235" as="geometry"/></mxCell><mxCell id="db-88" value="&lt;b&gt;Leyenda&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;PK&lt;/b&gt; clave primaria &lt;font color='#7a7a7a'&gt;(identifica cada fila)&lt;/font&gt;&lt;br&gt;&lt;b&gt;FK&lt;/b&gt; clave foránea &lt;font color='#7a7a7a'&gt;(apunta a otra tabla)&lt;/font&gt;&lt;br&gt;&lt;b&gt;UQ&lt;/b&gt; única &lt;font color='#7a7a7a'&gt;(no se repite)&lt;/font&gt;&lt;br&gt;&lt;font color='#8E44AD'&gt;&lt;b&gt;morado&lt;/b&gt;&lt;/font&gt; = columna relevante para seguridad&lt;br&gt;&lt;b&gt;┼──&amp;lt;&lt;/b&gt; 1:N &amp;nbsp;&amp;nbsp; &lt;b&gt;┼──┼&lt;/b&gt; 1:1&lt;br&gt;&lt;br&gt;&lt;i&gt;Las FK &lt;font face='Menlo'&gt;user_id → users&lt;/font&gt; de Interacción&lt;br&gt;no se dibujan para no saturar el diagrama.&lt;br&gt;Todas las FK usan ON DELETE CASCADE, salvo&lt;br&gt;&lt;font face='Menlo'&gt;video_views.user_id&lt;/font&gt; (SET NULL).&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;fontSize=13;align=left;spacingLeft=10;verticalAlign=top;spacingTop=6;fillColor=#fafafa;strokeColor=#999999;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1460" y="490" width="440" height="250" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Secuencia · Reproducción UDP" id="seq3"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="2083" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="seq3-1" value="&lt;b&gt;Secuencia 3 — Reproducción por UDP (WebRTC · DTLS-SRTP)&lt;/b&gt;" style="text;html=1;fontSize=22;align=left;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1460" height="36" as="geometry"/></mxCell><mxCell id="seq3-2" value="&lt;b&gt;Propósito:&lt;/b&gt; describe la reproducción. Autorización y señalización viajan por HTTPS (TCP); el video viaja por &lt;font color='#C0392B'&gt;&lt;b&gt;UDP cifrado con DTLS-SRTP&lt;/b&gt;&lt;/font&gt;.&lt;br&gt;&lt;font style='font-size:11px' color='#7a7a7a'&gt;Un tercero que intercepte el tráfico no puede ver ni modificar el video: solo obtiene datos cifrados.&lt;/font&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#f7f9fc;strokeColor=#c9d3e3;align=left;spacingLeft=12;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="58" width="1440" height="64" as="geometry"/></mxCell><mxCell id="seq3-3" value="Cliente React" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=55;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="150" width="180" height="1936" as="geometry"/></mxCell><mxCell id="seq3-4" value="Despachador" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=55;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="290" y="150" width="180" height="1936" as="geometry"/></mxCell><mxCell id="seq3-5" value="Backend" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=55;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="530" y="150" width="180" height="1936" as="geometry"/></mxCell><mxCell id="seq3-6" value="Servidor de Streaming" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=55;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="770" y="150" width="180" height="1936" as="geometry"/></mxCell><mxCell id="seq3-7" value="PostgreSQL" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=55;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1010" y="150" width="180" height="1936" as="geometry"/></mxCell><mxCell id="seq3-8" value="MinIO (bucket)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=55;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1250" y="150" width="180" height="1936" as="geometry"/></mxCell><mxCell id="seq3-9" value="&lt;b&gt;1 · Autorización (HTTPS / TCP)&lt;/b&gt;&amp;nbsp;&amp;nbsp;— &lt;font style='font-size:11px' color='#7a7a7a'&gt;¿puede este usuario ver el video?&lt;/font&gt;" style="rounded=0;html=1;fillColor=#f5f5f5;strokeColor=none;align=left;spacingLeft=8;fontSize=13;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="20" y="230" width="1440" height="30" as="geometry"/></mxCell><mxCell id="seq3-10" value="GET /api/videos/{id}/play&lt;br&gt;&lt;font style='font-size:11px' color='#7a7a7a'&gt;solicita reproducir el video&lt;/font&gt;" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;fontColor=#333333;fontSize=12;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="140" y="313" as="sourcePoint"/><mxPoint x="380" y="313" as="targetPoint"/></mxGeometry></mxCell><mxCell id="seq3-11" value="gRPC Authorize(user, video)&lt;br&gt;&lt;font style='font-size:11px' color='#7a7a7a'&gt;consulta si tiene permiso&lt;/font&gt;" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;fontColor=#333333;fontSize=12;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="380" y="371" as="sourcePoint"/><mxPoint x="620" y="371" as="targetPoint"/></mxGeometry></mxCell><mxCell id="seq3-12" value="SELECT visibility, owner_id&lt;br&gt;&lt;font style='font-size:11px' color='#7a7a7a'&gt;¿público, oculto o privado? ¿es el dueño?&lt;/font&gt;" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;fontColor=#333333;fontSize=12;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="620" y="429" as="sourcePoint"/><mxPoint x="1100" y="429" as="targetPoint"/></mxGeometry></mxCell><mxCell id="seq3-13" value="ticket = JWT ES256 {sub, vid, exp=60 s, jti}&lt;br&gt;&lt;font style='font-size:11px' color='#7a7a7a'&gt;emite un permiso temporal firmado digitalmente&lt;/font&gt;" style="html=1;endArrow=block;endFill=1;strokeColor=#8E44AD;fontColor=#8E44AD;fontSize=12;align=left;spacingLeft=6;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="620" y="465" as="sourcePoint"/><mxPoint x="620" y="489" as="targetPoint"/><Array as="points"><mxPoint x="656" y="465"/><mxPoint x="656" y="489"/></Array></mxGeometry></mxCell><mxCell id="seq3-14" value="ticket firmado" style="html=1;endArrow=open;endFill=0;strokeColor=#333333;fontColor=#333333;fontSize=12;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;strokeWidth=1;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="620" y="545" as="sourcePoint"/><mxPoint x="380" y="545" as="targetPoint"/></mxGeometry></mxCell><mxCell id="seq3-15" value="ticket" style="html=1;endArrow=open;endFill=0;strokeColor=#333333;fontColor=#333333;fontSize=12;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;strokeWidth=1;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="380" y="603" as="sourcePoint"/><mxPoint x="140" y="603" as="targetPoint"/></mxGeometry></mxCell><mxCell id="seq3-16" value="&lt;b&gt;2 · Señalización WebRTC (HTTPS / TCP)&lt;/b&gt;&amp;nbsp;&amp;nbsp;— &lt;font style='font-size:11px' color='#7a7a7a'&gt;navegador y servidor intercambian datos de conexión&lt;/font&gt;" style="rounded=0;html=1;fillColor=#f5f5f5;strokeColor=none;align=left;spacingLeft=8;fontSize=13;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="20" y="636" width="1440" height="30" as="geometry"/></mxCell><mxCell id="seq3-17" value="RTCPeerConnection · certificado ECDSA efímero&lt;br&gt;&lt;font style='font-size:11px' color='#7a7a7a'&gt;genera su identidad criptográfica para esta sesión&lt;/font&gt;" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;fontColor=#333333;fontSize=12;align=left;spacingLeft=6;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="140" y="697" as="sourcePoint"/><mxPoint x="140" y="721" as="targetPoint"/><Array as="points"><mxPoint x="176" y="697"/><mxPoint x="176" y="721"/></Array></mxGeometry></mxCell><mxCell id="seq3-18" value="POST /api/stream/offer {oferta SDP + a=fingerprint, ticket}&lt;br&gt;&lt;font style='font-size:11px' color='#7a7a7a'&gt;envía el permiso y la huella de su certificado&lt;/font&gt;" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;fontColor=#333333;fontSize=12;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="140" y="777" as="sourcePoint"/><mxPoint x="380" y="777" as="targetPoint"/></mxGeometry></mxCell><mxCell id="seq3-19" value="gRPC Offer(sdp, ticket)" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;fontColor=#333333;fontSize=12;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="380" y="835" as="sourcePoint"/><mxPoint x="860" y="835" as="targetPoint"/></mxGeometry></mxCell><mxCell id="seq3-20" value="verificar firma ES256 con la clave pública del Núcleo&lt;br&gt;&lt;font style='font-size:11px' color='#7a7a7a'&gt;comprueba que el permiso es auténtico y no venció&lt;/font&gt;" style="html=1;endArrow=block;endFill=1;strokeColor=#8E44AD;fontColor=#8E44AD;fontSize=12;align=left;spacingLeft=6;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="860" y="871" as="sourcePoint"/><mxPoint x="860" y="895" as="targetPoint"/><Array as="points"><mxPoint x="896" y="871"/><mxPoint x="896" y="895"/></Array></mxGeometry></mxCell><mxCell id="seq3-21" value="respuesta SDP (huella del servidor, candidato ICE :8443/udp)&lt;br&gt;&lt;font style='font-size:11px' color='#7a7a7a'&gt;responde con su huella y su dirección UDP&lt;/font&gt;" style="html=1;endArrow=open;endFill=0;strokeColor=#333333;fontColor=#333333;fontSize=12;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;strokeWidth=1;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="860" y="951" as="sourcePoint"/><mxPoint x="380" y="951" as="targetPoint"/></mxGeometry></mxCell><mxCell id="seq3-22" value="respuesta SDP" style="html=1;endArrow=open;endFill=0;strokeColor=#333333;fontColor=#333333;fontSize=12;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;strokeWidth=1;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="380" y="1009" as="sourcePoint"/><mxPoint x="140" y="1009" as="targetPoint"/></mxGeometry></mxCell><mxCell id="seq3-23" value="&lt;b&gt;3 · Negociación DTLS 1.2 · ECDHE-ECDSA (UDP 8443)&lt;/b&gt;&amp;nbsp;&amp;nbsp;— &lt;font style='font-size:11px' color='#7a7a7a'&gt;acuerdan una clave secreta y verifican identidades&lt;/font&gt;" style="rounded=0;html=1;fillColor=#f5f5f5;strokeColor=none;align=left;spacingLeft=8;fontSize=13;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="20" y="1042" width="1440" height="30" as="geometry"/></mxCell><mxCell id="seq3-24" value="Solicitud STUN Binding (ICE)&lt;br&gt;&lt;font style='font-size:11px' color='#7a7a7a'&gt;comprueba que hay conectividad UDP&lt;/font&gt;" style="html=1;endArrow=block;endFill=1;strokeColor=#C0392B;fontColor=#C0392B;fontSize=12;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="140" y="1125" as="sourcePoint"/><mxPoint x="860" y="1125" as="targetPoint"/></mxGeometry></mxCell><mxCell id="seq3-25" value="Respuesta STUN Binding" style="html=1;endArrow=open;endFill=0;strokeColor=#C0392B;fontColor=#C0392B;fontSize=12;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;strokeWidth=2;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="860" y="1183" as="sourcePoint"/><mxPoint x="140" y="1183" as="targetPoint"/></mxGeometry></mxCell><mxCell id="seq3-26" value="ClientHello (use_srtp, curvas P-256/X25519)&lt;br&gt;&lt;font style='font-size:11px' color='#7a7a7a'&gt;propone los algoritmos de cifrado&lt;/font&gt;" style="html=1;endArrow=block;endFill=1;strokeColor=#C0392B;fontColor=#C0392B;fontSize=12;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="140" y="1241" as="sourcePoint"/><mxPoint x="860" y="1241" as="targetPoint"/></mxGeometry></mxCell><mxCell id="seq3-27" value="ServerHello · Certificate · ServerKeyExchange (ECDHE firmado con ECDSA) · CertificateRequest&lt;br&gt;&lt;font style='font-size:11px' color='#7a7a7a'&gt;presenta su certificado y su parte de la clave, firmada&lt;/font&gt;" style="html=1;endArrow=open;endFill=0;strokeColor=#C0392B;fontColor=#C0392B;fontSize=12;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;strokeWidth=2;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="860" y="1299" as="sourcePoint"/><mxPoint x="140" y="1299" as="targetPoint"/></mxGeometry></mxCell><mxCell id="seq3-28" value="huella del certificado == SDP ✓ · verifica firma&lt;br&gt;&lt;font style='font-size:11px' color='#7a7a7a'&gt;confirma que habla con el servidor real (evita intermediarios)&lt;/font&gt;" style="html=1;endArrow=block;endFill=1;strokeColor=#8E44AD;fontColor=#8E44AD;fontSize=12;align=left;spacingLeft=6;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="140" y="1335" as="sourcePoint"/><mxPoint x="140" y="1359" as="targetPoint"/><Array as="points"><mxPoint x="176" y="1335"/><mxPoint x="176" y="1359"/></Array></mxGeometry></mxCell><mxCell id="seq3-29" value="Certificate · ClientKeyExchange · CertificateVerify · Finished&lt;br&gt;&lt;font style='font-size:11px' color='#7a7a7a'&gt;presenta su certificado y su parte de la clave&lt;/font&gt;" style="html=1;endArrow=block;endFill=1;strokeColor=#C0392B;fontColor=#C0392B;fontSize=12;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="140" y="1415" as="sourcePoint"/><mxPoint x="860" y="1415" as="targetPoint"/></mxGeometry></mxCell><mxCell id="seq3-30" value="huella del certificado del cliente == SDP ✓&lt;br&gt;&lt;font style='font-size:11px' color='#7a7a7a'&gt;confirma la identidad del navegador&lt;/font&gt;" style="html=1;endArrow=block;endFill=1;strokeColor=#8E44AD;fontColor=#8E44AD;fontSize=12;align=left;spacingLeft=6;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="860" y="1451" as="sourcePoint"/><mxPoint x="860" y="1475" as="targetPoint"/><Array as="points"><mxPoint x="896" y="1451"/><mxPoint x="896" y="1475"/></Array></mxGeometry></mxCell><mxCell id="seq3-31" value="ChangeCipherSpec · Finished&lt;br&gt;&lt;font style='font-size:11px' color='#7a7a7a'&gt;a partir de aquí todo viaja cifrado&lt;/font&gt;" style="html=1;endArrow=open;endFill=0;strokeColor=#C0392B;fontColor=#C0392B;fontSize=12;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;strokeWidth=2;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="860" y="1531" as="sourcePoint"/><mxPoint x="140" y="1531" as="targetPoint"/></mxGeometry></mxCell><mxCell id="seq3-32" value="Claves SRTP derivadas del secreto DTLS (RFC 5764)&lt;br&gt;&lt;font style='font-size:11px' color='#7a7a7a'&gt;ambos calculan la misma clave sin que esta viaje nunca por la red (Diffie-Hellman)&lt;/font&gt;" style="shape=note;size=10;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="1559" width="880" height="40" as="geometry"/></mxCell><mxCell id="seq3-33" value="&lt;b&gt;4 · Descifrado y envío de medios&lt;/b&gt;" style="rounded=0;html=1;fillColor=#f5f5f5;strokeColor=none;align=left;spacingLeft=8;fontSize=13;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="20" y="1622" width="1440" height="30" as="geometry"/></mxCell><mxCell id="seq3-34" value="SELECT wrapped_dek&lt;br&gt;&lt;font style='font-size:11px' color='#7a7a7a'&gt;obtiene la clave del video, todavía cifrada&lt;/font&gt;" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;fontColor=#333333;fontSize=12;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="860" y="1705" as="sourcePoint"/><mxPoint x="1100" y="1705" as="targetPoint"/></mxGeometry></mxCell><mxCell id="seq3-35" value="GET videos/{id}/video.enc&lt;br&gt;&lt;font style='font-size:11px' color='#7a7a7a'&gt;descarga el archivo cifrado&lt;/font&gt;" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;fontColor=#333333;fontSize=12;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="860" y="1763" as="sourcePoint"/><mxPoint x="1340" y="1763" as="targetPoint"/></mxGeometry></mxCell><mxCell id="seq3-36" value="DEK = HPKE.Open(clave PRIVADA, wrapped_dek)&lt;br&gt;&lt;font style='font-size:11px' color='#7a7a7a'&gt;descifra la clave del video con su clave privada&lt;/font&gt;" style="html=1;endArrow=block;endFill=1;strokeColor=#8E44AD;fontColor=#8E44AD;fontSize=12;align=left;spacingLeft=6;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="860" y="1799" as="sourcePoint"/><mxPoint x="860" y="1823" as="targetPoint"/><Array as="points"><mxPoint x="896" y="1799"/><mxPoint x="896" y="1823"/></Array></mxGeometry></mxCell><mxCell id="seq3-37" value="descifrar bloques AES-256-GCM → frames VP8/Opus&lt;br&gt;&lt;font style='font-size:11px' color='#7a7a7a'&gt;descifra el video en memoria; si fue alterado, falla&lt;/font&gt;" style="html=1;endArrow=block;endFill=1;strokeColor=#8E44AD;fontColor=#8E44AD;fontSize=12;align=left;spacingLeft=6;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="860" y="1857" as="sourcePoint"/><mxPoint x="860" y="1881" as="targetPoint"/><Array as="points"><mxPoint x="896" y="1857"/><mxPoint x="896" y="1881"/></Array></mxGeometry></mxCell><mxCell id="seq3-38" value="bucle: RTP cifrado con SRTP AES-128-GCM (video + audio)&lt;br&gt;&lt;font style='font-size:11px' color='#7a7a7a'&gt;envía el video en paquetes cifrados&lt;/font&gt;" style="html=1;endArrow=block;endFill=1;strokeColor=#C0392B;fontColor=#C0392B;fontSize=12;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="860" y="1937" as="sourcePoint"/><mxPoint x="140" y="1937" as="targetPoint"/></mxGeometry></mxCell><mxCell id="seq3-39" value="SRTCP: reportes de recepción / NACK&lt;br&gt;&lt;font style='font-size:11px' color='#7a7a7a'&gt;informa de paquetes perdidos para reenviarlos&lt;/font&gt;" style="html=1;endArrow=block;endFill=1;strokeColor=#C0392B;fontColor=#C0392B;fontSize=12;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;strokeWidth=2;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="140" y="1995" as="sourcePoint"/><mxPoint x="860" y="1995" as="targetPoint"/></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram name="Secuencia · Subida cifrada" id="seq2"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1510" pageHeight="1213" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="seq2-1" value="&lt;b&gt;Secuencia 2 — Subida y almacenamiento cifrado&lt;/b&gt;" style="text;html=1;fontSize=22;align=left;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1470" height="36" as="geometry"/></mxCell><mxCell id="seq2-2" value="&lt;b&gt;Propósito:&lt;/b&gt; describe la subida y el almacenamiento cifrado (cifrado híbrido: AES-256-GCM para el contenido y HPKE para la clave).&lt;br&gt;&lt;font style='font-size:11px' color='#7a7a7a'&gt;Si alguien obtiene el bucket o la base de datos, solo consigue archivos y claves cifradas, inservibles sin la clave privada.&lt;/font&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#f7f9fc;strokeColor=#c9d3e3;align=left;spacingLeft=12;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="58" width="1450" height="64" as="geometry"/></mxCell><mxCell id="seq2-3" value="Cliente React" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=55;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="75" y="150" width="180" height="1066" as="geometry"/></mxCell><mxCell id="seq2-4" value="Despachador" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=55;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="365" y="150" width="180" height="1066" as="geometry"/></mxCell><mxCell id="seq2-5" value="Backend" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=55;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="655" y="150" width="180" height="1066" as="geometry"/></mxCell><mxCell id="seq2-6" value="PostgreSQL" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=55;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="945" y="150" width="180" height="1066" as="geometry"/></mxCell><mxCell id="seq2-7" value="MinIO (bucket)" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=55;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1235" y="150" width="180" height="1066" as="geometry"/></mxCell><mxCell id="seq2-8" value="&lt;b&gt;1 · Subida por HTTPS (TCP)&lt;/b&gt;" style="rounded=0;html=1;fillColor=#f5f5f5;strokeColor=none;align=left;spacingLeft=8;fontSize=13;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="20" y="230" width="1450" height="30" as="geometry"/></mxCell><mxCell id="seq2-9" value="POST /api/videos (multipart, cookie, visibilidad)&lt;br&gt;&lt;font style='font-size:11px' color='#7a7a7a'&gt;envía el archivo y elige público, oculto o privado&lt;/font&gt;" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;fontColor=#333333;fontSize=12;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="165" y="313" as="sourcePoint"/><mxPoint x="455" y="313" as="targetPoint"/></mxGeometry></mxCell><mxCell id="seq2-10" value="gRPC UploadVideo(stream)" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;fontColor=#333333;fontSize=12;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="455" y="371" as="sourcePoint"/><mxPoint x="745" y="371" as="targetPoint"/></mxGeometry></mxCell><mxCell id="seq2-11" value="validar sesión · INSERT videos (status = processing)&lt;br&gt;&lt;font style='font-size:11px' color='#7a7a7a'&gt;registra el video como «en proceso»&lt;/font&gt;" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;fontColor=#333333;fontSize=12;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="745" y="429" as="sourcePoint"/><mxPoint x="1035" y="429" as="targetPoint"/></mxGeometry></mxCell><mxCell id="seq2-12" value="ffmpeg → video.ivf (VP8) + audio.ogg (Opus)&lt;br&gt;&lt;font style='font-size:11px' color='#7a7a7a'&gt;convierte a formatos compatibles con WebRTC&lt;/font&gt;" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;fontColor=#333333;fontSize=12;align=left;spacingLeft=6;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="745" y="465" as="sourcePoint"/><mxPoint x="745" y="489" as="targetPoint"/><Array as="points"><mxPoint x="781" y="465"/><mxPoint x="781" y="489"/></Array></mxGeometry></mxCell><mxCell id="seq2-13" value="&lt;b&gt;2 · Cifrado híbrido en reposo&lt;/b&gt;&amp;nbsp;&amp;nbsp;— &lt;font style='font-size:11px' color='#7a7a7a'&gt;el video se guarda cifrado&lt;/font&gt;" style="rounded=0;html=1;fillColor=#f5f5f5;strokeColor=none;align=left;spacingLeft=8;fontSize=13;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="20" y="520" width="1450" height="30" as="geometry"/></mxCell><mxCell id="seq2-14" value="DEK = 256 bits aleatorios (SecureRandom)&lt;br&gt;&lt;font style='font-size:11px' color='#7a7a7a'&gt;genera una clave única para este video&lt;/font&gt;" style="html=1;endArrow=block;endFill=1;strokeColor=#8E44AD;fontColor=#8E44AD;fontSize=12;align=left;spacingLeft=6;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="745" y="581" as="sourcePoint"/><mxPoint x="745" y="605" as="targetPoint"/><Array as="points"><mxPoint x="781" y="581"/><mxPoint x="781" y="605"/></Array></mxGeometry></mxCell><mxCell id="seq2-15" value="video.enc = AES-256-GCM(DEK) por bloques de 1 MiB&lt;br&gt;&lt;font style='font-size:11px' color='#7a7a7a'&gt;cifra el video con algoritmo simétrico, rápido para archivos grandes&lt;/font&gt;" style="html=1;endArrow=block;endFill=1;strokeColor=#8E44AD;fontColor=#8E44AD;fontSize=12;align=left;spacingLeft=6;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="745" y="639" as="sourcePoint"/><mxPoint x="745" y="663" as="targetPoint"/><Array as="points"><mxPoint x="781" y="639"/><mxPoint x="781" y="663"/></Array></mxGeometry></mxCell><mxCell id="seq2-16" value="wrapped_dek = HPKE.Seal(clave PÚBLICA del Servidor de Streaming, DEK)&lt;br&gt;&lt;font style='font-size:11px' color='#7a7a7a'&gt;protege esa clave con criptografía asimétrica&lt;/font&gt;" style="html=1;endArrow=block;endFill=1;strokeColor=#8E44AD;fontColor=#8E44AD;fontSize=12;align=left;spacingLeft=6;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="745" y="697" as="sourcePoint"/><mxPoint x="745" y="721" as="targetPoint"/><Array as="points"><mxPoint x="781" y="697"/><mxPoint x="781" y="721"/></Array></mxGeometry></mxCell><mxCell id="seq2-17" value="El Núcleo solo tiene la clave pública: puede cifrar pero NUNCA descifrar&lt;br&gt;&lt;font style='font-size:11px' color='#7a7a7a'&gt;solo el Servidor de Streaming, con la clave privada, puede recuperar la DEK&lt;/font&gt;" style="shape=note;size=10;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="665" y="747" width="740" height="40" as="geometry"/></mxCell><mxCell id="seq2-18" value="PUT videos/{id}/video.enc&lt;br&gt;&lt;font style='font-size:11px' color='#7a7a7a'&gt;guarda el archivo cifrado en el bucket&lt;/font&gt;" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;fontColor=#333333;fontSize=12;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="745" y="835" as="sourcePoint"/><mxPoint x="1325" y="835" as="targetPoint"/></mxGeometry></mxCell><mxCell id="seq2-19" value="INSERT video_assets (encrypted_blob, sha256) · video_keys (wrapped_dek)&lt;br&gt;&lt;font style='font-size:11px' color='#7a7a7a'&gt;guarda la clave protegida y la huella del archivo&lt;/font&gt;" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;fontColor=#333333;fontSize=12;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="745" y="893" as="sourcePoint"/><mxPoint x="1035" y="893" as="targetPoint"/></mxGeometry></mxCell><mxCell id="seq2-20" value="borrar DEK y archivos en claro&lt;br&gt;&lt;font style='font-size:11px' color='#7a7a7a'&gt;no quedan copias sin cifrar&lt;/font&gt;" style="html=1;endArrow=block;endFill=1;strokeColor=#8E44AD;fontColor=#8E44AD;fontSize=12;align=left;spacingLeft=6;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="745" y="929" as="sourcePoint"/><mxPoint x="745" y="953" as="targetPoint"/><Array as="points"><mxPoint x="781" y="929"/><mxPoint x="781" y="953"/></Array></mxGeometry></mxCell><mxCell id="seq2-21" value="UPDATE videos SET status = ready&lt;br&gt;&lt;font style='font-size:11px' color='#7a7a7a'&gt;el video queda disponible&lt;/font&gt;" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;fontColor=#333333;fontSize=12;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="745" y="1009" as="sourcePoint"/><mxPoint x="1035" y="1009" as="targetPoint"/></mxGeometry></mxCell><mxCell id="seq2-22" value="VideoCreated{id}" style="html=1;endArrow=open;endFill=0;strokeColor=#333333;fontColor=#333333;fontSize=12;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;strokeWidth=1;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="745" y="1067" as="sourcePoint"/><mxPoint x="455" y="1067" as="targetPoint"/></mxGeometry></mxCell><mxCell id="seq2-23" value="201 Created" style="html=1;endArrow=open;endFill=0;strokeColor=#333333;fontColor=#333333;fontSize=12;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;strokeWidth=1;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="455" y="1125" as="sourcePoint"/><mxPoint x="165" y="1125" as="targetPoint"/></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram name="Secuencia · Inicio de sesión (TCP)" id="seq1"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1155" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="seq1-1" value="&lt;b&gt;Secuencia 1 — Inicio de sesión sobre HTTPS/TCP&lt;/b&gt;" style="text;html=1;fontSize=22;align=left;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1460" height="36" as="geometry"/></mxCell><mxCell id="seq1-2" value="&lt;b&gt;Propósito:&lt;/b&gt; describe el inicio de sesión. La contraseña viaja dentro de un canal TLS 1.3 y en la base de datos solo se guarda su hash Argon2id.&lt;br&gt;&lt;font style='font-size:11px' color='#7a7a7a'&gt;Un hash es una huella irreversible: permite comprobar la contraseña sin tener que guardarla.&lt;/font&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#f7f9fc;strokeColor=#c9d3e3;align=left;spacingLeft=12;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="58" width="1440" height="64" as="geometry"/></mxCell><mxCell id="seq1-3" value="Usuario" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=55;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="50" y="150" width="180" height="1008" as="geometry"/></mxCell><mxCell id="seq1-4" value="Cliente React" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=55;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="290" y="150" width="180" height="1008" as="geometry"/></mxCell><mxCell id="seq1-5" value="NGINX" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=55;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="530" y="150" width="180" height="1008" as="geometry"/></mxCell><mxCell id="seq1-6" value="Despachador" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=55;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="770" y="150" width="180" height="1008" as="geometry"/></mxCell><mxCell id="seq1-7" value="Backend" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=55;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1010" y="150" width="180" height="1008" as="geometry"/></mxCell><mxCell id="seq1-8" value="PostgreSQL" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=55;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1250" y="150" width="180" height="1008" as="geometry"/></mxCell><mxCell id="seq1-9" value="&lt;b&gt;1 · Canal seguro TLS 1.3 sobre TCP&lt;/b&gt;&amp;nbsp;&amp;nbsp;— &lt;font style='font-size:11px' color='#7a7a7a'&gt;antes de enviar datos se cifra la conexión&lt;/font&gt;" style="rounded=0;html=1;fillColor=#f5f5f5;strokeColor=none;align=left;spacingLeft=8;fontSize=13;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="20" y="230" width="1440" height="30" as="geometry"/></mxCell><mxCell id="seq1-10" value="usuario + contraseña" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;fontColor=#333333;fontSize=12;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="140" y="313" as="sourcePoint"/><mxPoint x="380" y="313" as="targetPoint"/></mxGeometry></mxCell><mxCell id="seq1-11" value="ClientHello (key_share ECDHE X25519)&lt;br&gt;&lt;font style='font-size:11px' color='#7a7a7a'&gt;propone cifrar la conexión&lt;/font&gt;" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;fontColor=#333333;fontSize=12;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="380" y="371" as="sourcePoint"/><mxPoint x="620" y="371" as="targetPoint"/></mxGeometry></mxCell><mxCell id="seq1-12" value="ServerHello + Certificado + CertificateVerify (firma)&lt;br&gt;&lt;font style='font-size:11px' color='#7a7a7a'&gt;demuestra ser el servidor legítimo&lt;/font&gt;" style="html=1;endArrow=open;endFill=0;strokeColor=#333333;fontColor=#333333;fontSize=12;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;strokeWidth=1;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="620" y="429" as="sourcePoint"/><mxPoint x="380" y="429" as="targetPoint"/></mxGeometry></mxCell><mxCell id="seq1-13" value="Clave de sesión AES-GCM derivada de ECDHE&lt;br&gt;&lt;font style='font-size:11px' color='#7a7a7a'&gt;desde aquí toda la comunicación va cifrada&lt;/font&gt;" style="shape=note;size=10;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="300" y="457" width="400" height="40" as="geometry"/></mxCell><mxCell id="seq1-14" value="&lt;b&gt;2 · Autenticación&lt;/b&gt;&amp;nbsp;&amp;nbsp;— &lt;font style='font-size:11px' color='#7a7a7a'&gt;comprobar que la contraseña es correcta&lt;/font&gt;" style="rounded=0;html=1;fillColor=#f5f5f5;strokeColor=none;align=left;spacingLeft=8;fontSize=13;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="20" y="520" width="1440" height="30" as="geometry"/></mxCell><mxCell id="seq1-15" value="POST /api/auth/login {usuario, contraseña}&lt;br&gt;&lt;font style='font-size:11px' color='#7a7a7a'&gt;las credenciales viajan dentro del canal cifrado&lt;/font&gt;" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;fontColor=#333333;fontSize=12;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="380" y="603" as="sourcePoint"/><mxPoint x="620" y="603" as="targetPoint"/></mxGeometry></mxCell><mxCell id="seq1-16" value="proxy HTTP" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;fontColor=#333333;fontSize=12;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="620" y="661" as="sourcePoint"/><mxPoint x="860" y="661" as="targetPoint"/></mxGeometry></mxCell><mxCell id="seq1-17" value="gRPC Login()" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;fontColor=#333333;fontSize=12;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="860" y="719" as="sourcePoint"/><mxPoint x="1100" y="719" as="targetPoint"/></mxGeometry></mxCell><mxCell id="seq1-18" value="SELECT password_hash&lt;br&gt;&lt;font style='font-size:11px' color='#7a7a7a'&gt;obtiene la huella guardada&lt;/font&gt;" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;fontColor=#333333;fontSize=12;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1100" y="777" as="sourcePoint"/><mxPoint x="1340" y="777" as="targetPoint"/></mxGeometry></mxCell><mxCell id="seq1-19" value="hash Argon2id" style="html=1;endArrow=open;endFill=0;strokeColor=#333333;fontColor=#333333;fontSize=12;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;strokeWidth=1;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1340" y="835" as="sourcePoint"/><mxPoint x="1100" y="835" as="targetPoint"/></mxGeometry></mxCell><mxCell id="seq1-20" value="verificar hash&lt;br&gt;&lt;font style='font-size:11px' color='#7a7a7a'&gt;compara huellas: la contraseña nunca se almacena&lt;/font&gt;" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;fontColor=#333333;fontSize=12;align=left;spacingLeft=6;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1100" y="871" as="sourcePoint"/><mxPoint x="1100" y="895" as="targetPoint"/><Array as="points"><mxPoint x="1136" y="871"/><mxPoint x="1136" y="895"/></Array></mxGeometry></mxCell><mxCell id="seq1-21" value="INSERT sessions (token_hash = SHA-256(token))&lt;br&gt;&lt;font style='font-size:11px' color='#7a7a7a'&gt;guarda solo la huella del token de sesión&lt;/font&gt;" style="html=1;endArrow=block;endFill=1;strokeColor=#333333;fontColor=#333333;fontSize=12;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;strokeWidth=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1100" y="951" as="sourcePoint"/><mxPoint x="1340" y="951" as="targetPoint"/></mxGeometry></mxCell><mxCell id="seq1-22" value="token de sesión" style="html=1;endArrow=open;endFill=0;strokeColor=#333333;fontColor=#333333;fontSize=12;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;strokeWidth=1;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1100" y="1009" as="sourcePoint"/><mxPoint x="860" y="1009" as="targetPoint"/></mxGeometry></mxCell><mxCell id="seq1-23" value="200 OK · Set-Cookie HttpOnly; Secure; SameSite=Strict&lt;br&gt;&lt;font style='font-size:11px' color='#7a7a7a'&gt;cookie inaccesible desde JavaScript y solo por HTTPS&lt;/font&gt;" style="html=1;endArrow=open;endFill=0;strokeColor=#333333;fontColor=#333333;fontSize=12;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;strokeWidth=1;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="860" y="1067" as="sourcePoint"/><mxPoint x="380" y="1067" as="targetPoint"/></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>