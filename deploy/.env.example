# Copia este archivo a deploy/.env y ajusta los valores:
#   cd deploy && cp .env.example .env
# .env está en .gitignore: no lo subas al repo.

# --- Red ---
# IP/host con el que se accede a la plataforma. Se usa en el certificado TLS local
# y como candidato ICE del Streaming Server (debe ser alcanzable desde el navegador).
PUBLIC_IP=127.0.0.1

# --- PostgreSQL ---
POSTGRES_DB=youbeam
POSTGRES_USER=youbeam
# Sin caracteres especiales (@ : / ?): se usa dentro de DATABASE_URL.
POSTGRES_PASSWORD=change_this_local_password
# Puerto publicado en localhost SOLO en desarrollo (docker-compose.override.yml).
# Dentro de la red Docker Postgres siempre usa 5432.
POSTGRES_PORT=5432

# --- MinIO ---
MINIO_USER=youbeam
# Sin caracteres especiales: se usa en variables de entorno de varios servicios.
MINIO_PASSWORD=change_this_minio_password
# API S3: solo se publica en desarrollo (override). Consola: siempre en 127.0.0.1.
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
