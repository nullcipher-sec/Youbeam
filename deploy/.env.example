# Copiar a deploy/.env y ajustar:  cp deploy/.env.example deploy/.env
# .env nunca se sube al repositorio.

# PostgreSQL. POSTGRES_PORT es el puerto publicado en localhost SOLO en desarrollo;
# dentro de la red de Docker Postgres siempre usa 5432.
# Usar una contraseña sin caracteres especiales (@ : / ? #): también va dentro de una URL.
POSTGRES_DB=youbeam
POSTGRES_USER=youbeam
POSTGRES_PASSWORD=change_this_local_password
POSTGRES_PORT=5432

# MinIO (almacenamiento S3 de los videos cifrados)
MINIO_USER=minioadmin
MINIO_PASSWORD=minioadmin

# IP con la que el navegador alcanza la plataforma. La usa el certificado TLS local
# (scripts/gen-secrets.sh) y el Streaming Server como candidato ICE de WebRTC.
PUBLIC_IP=127.0.0.1
